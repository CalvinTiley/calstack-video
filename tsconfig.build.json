{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "dist",
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext"
    },
    "exclude": ["src/sandbox.tsx"],
    "extends": "./tsconfig.json",
    "include": ["src"]
}
